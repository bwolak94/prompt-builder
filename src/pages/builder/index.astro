---
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import BuilderIsland from '@/components/builder/BuilderIsland';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?redirect=/builder');
---

<AppLayout
  title="Nowy prompt — PromptBase"
  breadcrumbs={[
    { label: 'Dashboard', href: '/dashboard' },
    { label: 'Nowy prompt' },
  ]}
>
  <BuilderIsland client:load />
</AppLayout>
