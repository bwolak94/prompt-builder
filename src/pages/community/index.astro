---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import CommunityFeedIsland from '@/components/community/CommunityFeedIsland';
import { communityFeedRepo } from '@/db/repositories/community-feed.repo';
import { getT } from '@/lib/i18n';

const lang = Astro.locals.lang;
const t = getT(lang);
const user = Astro.locals.user;

// Fetch initial trending page server-side for fast first paint
const { items: initialItems, nextCursor: initialNextCursor } =
  await communityFeedRepo.findFeed(Astro.locals.supabase, {
    tab: 'trending',
    period: 'all',
  });
---

<BaseLayout
  title={`${t('community.title')} — PromptBase`}
  description={t('community.subtitle')}
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-8">
    <CommunityFeedIsland
      lang={lang}
      initialItems={initialItems}
      initialNextCursor={initialNextCursor}
      isLoggedIn={!!user}
      client:load
    />
  </main>
</BaseLayout>
