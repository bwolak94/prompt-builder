---
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import { SettingsIsland } from '@/components/settings/SettingsIsland';
import { profileService } from '@/lib/services/profile.service';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?redirect=/settings');

const profile = await profileService.getProfile(Astro.locals.supabase, user.id);

// If profile doesn't exist yet, create a default one
const profileData = profile ?? {
  id: user.id,
  display_name: user.email?.split('@')[0] ?? 'User',
  username: null,
  bio: null,
  avatar_url: null,
  preferences: { defaultModel: 'openai' as const, language: 'pl' as const },
};

const email = user.email ?? '';
---

<AppLayout
  title="Ustawienia — PromptBase"
  breadcrumbs={[
    { label: 'Dashboard', href: '/dashboard' },
    { label: 'Ustawienia' },
  ]}
>
  <SettingsIsland client:load profile={profileData} email={email} />
</AppLayout>
