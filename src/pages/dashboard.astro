---
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import { DashboardIsland } from '@/components/dashboard/DashboardIsland';
import { promptRepo } from '@/db/repositories/prompt.repo';
import { collectionRepo } from '@/db/repositories/collection.repo';
import { buildCollectionTree } from '@/lib/services/collection.service';

const lang = Astro.locals.lang;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?redirect=/dashboard');

const errorParam = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  not_found: 'Prompt nie został znaleziony.',
  forbidden: 'Nie masz dostępu do tego promptu.',
};

// F-09: collections — read active collection from URL
const activeCollectionId = Astro.url.searchParams.get('collection');
const collectionsFlat = await collectionRepo.findByUser(Astro.locals.supabase, user.id);
const initialCollectionTree = buildCollectionTree(collectionsFlat);

// Fetch prompts server-side — filtered by collection if ?collection= is present
const allPrompts = await promptRepo.findByUserId(Astro.locals.supabase, user.id);
const prompts = activeCollectionId
  ? await collectionRepo.findPromptsInCollection(Astro.locals.supabase, activeCollectionId)
  : allPrompts;

// Stats always based on the full set
const publicCount = allPrompts.filter((p) => p.is_public).length;
const forks = allPrompts.reduce((sum, p) => sum + (p.fork_count ?? 0), 0);

let avgScore: number | null = null;
if (allPrompts.length > 0) {
  const { data: ratings } = await Astro.locals.supabase
    .from('prompt_ratings')
    .select('overall_score')
    .in('prompt_id', allPrompts.map((p) => p.id));
  if (ratings && ratings.length > 0) {
    avgScore = Math.round(ratings.reduce((s: number, r: { overall_score: number }) => s + r.overall_score, 0) / ratings.length);
  }
}

const initialStats = { total: allPrompts.length, public: publicCount, forks, avgScore };
---

<AppLayout
  title="Dashboard — PromptBase"
  breadcrumbs={[{ label: 'Dashboard' }]}
>
  <DashboardIsland
    client:load
    initialPrompts={prompts}
    initialStats={initialStats}
    initialCollectionTree={initialCollectionTree}
    initialActiveCollectionId={activeCollectionId}
    lang={lang}
  />
</AppLayout>

{errorParam && errorMessages[errorParam] && (
  <script define:vars={{ msg: errorMessages[errorParam] }}>
    import('sonner').then(({ toast }) => toast.error(msg));
  </script>
)}
