---
import PublicLayout from '@/layouts/PublicLayout.astro';
import LoginForm from '@/components/auth/LoginForm';

// Already authenticated → go to dashboard
if (Astro.locals.user) {
  return Astro.redirect('/dashboard', 302);
}

// Pass ?redirect= param to the form so it can redirect back after login
const redirect = Astro.url.searchParams.get('redirect') ?? '/dashboard';
---

<PublicLayout
  title="Zaloguj się"
  description="Zaloguj się do swojego konta PromptBase."
  noindex
>
  <div class="flex min-h-[calc(100dvh-8rem)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-text-primary">Witaj z powrotem</h1>
        <p class="mt-2 text-sm text-text-secondary">
          Nie masz konta?{' '}
          <a href="/register" class="text-brand-400 hover:text-brand-300 transition-colors">
            Zarejestruj się
          </a>
        </p>
      </div>

      <LoginForm client:load redirectTo={redirect} />
    </div>
  </div>
</PublicLayout>
