---
import '@/styles/globals.css';
import SEO from '@/components/common/SEO.astro';
import { Toaster } from 'sonner';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Wizualny builder promptów z AI scoringiem. Dla developerów i entuzjastów AI.',
  ogImage,
  canonical,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="pl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      noindex={noindex}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Skip to main content (a11y) -->
    <style is:inline>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        z-index: 9999;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>

    <!-- Font preload — Inter Variable (woff2 subset for Latin) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin.woff2"
      crossorigin="anonymous"
    />

    <!-- FOUC prevention: apply stored theme before first paint -->
    <script is:inline>
      (function () {
        try {
          const theme = localStorage.getItem('theme') || 'dark';
          document.documentElement.classList.remove('dark', 'light');
          document.documentElement.classList.add(theme);
        } catch {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Skip-to-main link — hidden until focused (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="skip-link bg-brand-500 focus:ring-brand-400 rounded-md px-4 py-2 text-sm font-semibold text-white focus:ring-2 focus:outline-none"
    >
      Przejdź do treści
    </a>

    <slot />
    <Toaster client:load theme="dark" position="bottom-right" richColors closeButton />
  </body>
</html>
