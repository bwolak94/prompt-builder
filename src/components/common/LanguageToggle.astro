---
/**
 * LanguageToggle — switches between PL and EN via POST /api/lang.
 * Works as a plain HTML button (no JavaScript required).
 */
import type { Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nextLang: Lang = lang === 'pl' ? 'en' : 'pl';
const label = lang === 'pl' ? 'Switch to English' : 'Przełącz na Polski';
---

<button
  id="lang-toggle"
  type="button"
  aria-label={label}
  title={label}
  data-next-lang={nextLang}
  data-current-url={Astro.url.pathname + Astro.url.search}
  class="border-border text-text-secondary hover:border-brand-500/50 hover:text-text-primary flex h-8 items-center gap-1.5 rounded-md border px-2.5 text-xs font-medium transition-colors"
>
  <span class="font-semibold tracking-wide uppercase" aria-hidden="true">
    {lang === 'pl' ? '🇵🇱 PL' : '🇬🇧 EN'}
  </span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="10"
    height="10"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="opacity-60"
  >
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('lang-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const next = btn.getAttribute('data-next-lang');
      fetch('/api/lang', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang: next }),
      }).then(function () {
        window.location.reload();
      });
    });
  })();
</script>
