---
/**
 * ThemeToggle — dark/light mode switch.
 *
 * Strategy (dark-first):
 *  - Default: html has class="dark" (set by BaseLayout, TASK-012)
 *  - Toggle adds class="light" and removes "dark" (or vice-versa)
 *  - Persists to localStorage under key "theme"
 *  - The FOUC-prevention inline script lives in BaseLayout <head>
 *    and reads the same localStorage key before first paint.
 *
 * This component renders the toggle button only.
 * It reads the initial state from data-theme attribute written by JS.
 */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Przełącz motyw kolorystyczny"
  title="Przełącz motyw"
  class="text-text-secondary hover:bg-surface-overlay hover:text-text-primary focus-visible:outline-brand-500 relative flex h-9 w-9 items-center justify-center rounded-md transition-colors duration-150 focus-visible:outline-2"
>
  <!-- Sun icon — visible in dark mode (click → switch to light) -->
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="absolute transition-all duration-200"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>

  <!-- Moon icon — visible in light mode (click → switch to dark) -->
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="absolute transition-all duration-200"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'theme';
    const htmlEl = document.documentElement;

    function getStoredTheme() {
      try {
        return localStorage.getItem(STORAGE_KEY) || 'dark';
      } catch {
        return 'dark';
      }
    }

    function applyTheme(theme) {
      if (theme === 'light') {
        htmlEl.classList.add('light');
        htmlEl.classList.remove('dark');
      } else {
        htmlEl.classList.add('dark');
        htmlEl.classList.remove('light');
      }

      const sunIcon = document.getElementById('icon-sun');
      const moonIcon = document.getElementById('icon-moon');
      const toggleBtn = document.getElementById('theme-toggle');

      if (!sunIcon || !moonIcon) return;

      if (theme === 'dark') {
        // Dark mode active: show Sun icon (click → switch to light)
        sunIcon.style.opacity = '1';
        sunIcon.style.transform = 'rotate(0deg) scale(1)';
        moonIcon.style.opacity = '0';
        moonIcon.style.transform = 'rotate(90deg) scale(0.5)';
      } else {
        // Light mode active: show Moon icon (click → switch to dark)
        sunIcon.style.opacity = '0';
        sunIcon.style.transform = 'rotate(-90deg) scale(0.5)';
        moonIcon.style.opacity = '1';
        moonIcon.style.transform = 'rotate(0deg) scale(1)';
      }

      if (toggleBtn) {
        toggleBtn.setAttribute(
          'aria-label',
          theme === 'dark' ? 'Przełącz na jasny motyw' : 'Przełącz na ciemny motyw',
        );
      }
    }

    // Apply on component mount
    applyTheme(getStoredTheme());

    // Register toggle handler
    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function () {
        const current = getStoredTheme();
        const next = current === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch {
          // localStorage unavailable (private browsing, etc.) — still toggle visually
        }
        applyTheme(next);
      });
    }
  })();
</script>
