---
import BuilderPreviewBlocks from './BuilderPreviewBlocks';
---

<section class="px-4 py-20 sm:py-28" aria-labelledby="preview-heading">
  <div class="mx-auto max-w-5xl">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <!-- Left: copy -->
      <div>
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
          <span class="text-xs font-medium text-brand-300">Visual Builder</span>
        </div>

        <h2
          id="preview-heading"
          class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl"
        >
          Struktura promptu<br />widoczna na pierwszy rzut oka
        </h2>

        <p class="mt-4 text-text-secondary leading-relaxed">
          Zamiast ściany tekstu — kolorowe bloki sekcji. Każda część promptu ma swoje miejsce
          i kolor. Dodawaj, usuwaj, przestawiaj bez dotykania surowego tekstu.
        </p>

        <ul class="mt-6 space-y-2.5">
          {[
            '10 typów sekcji z opisami i podpowiedziami',
            'Drag & drop do reorderowania bloków',
            'Zmienne {{jak_ta}} z dynamicznym podglądem',
            'Export do Markdown jednym kliknięciem',
          ].map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-text-secondary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-0.5 shrink-0 text-brand-400"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: animated builder preview -->
      <div class="rounded-xl border border-border bg-surface-raised p-4 shadow-xl">
        <!-- Mock toolbar -->
        <div class="mb-3 flex items-center justify-between border-b border-border pb-3">
          <span class="text-sm font-medium text-text-primary">Mój Senior Dev Prompt</span>
          <div class="flex items-center gap-2">
            <span class="rounded border border-border px-2 py-0.5 text-xs text-text-muted">Prywatny</span>
            <span class="rounded bg-brand-500 px-2.5 py-0.5 text-xs font-medium text-white">Zapisz</span>
          </div>
        </div>

        <!-- Animated blocks -->
        <BuilderPreviewBlocks client:visible />

        <!-- Mock AI score bar at bottom -->
        <div class="mt-4 flex items-center justify-between rounded-lg border border-emerald-600/20 bg-emerald-600/8 px-3 py-2">
          <span class="text-xs text-text-secondary">AI Score</span>
          <div class="flex items-center gap-2">
            <div class="h-1.5 w-24 overflow-hidden rounded-full bg-border">
              <div class="h-full w-[84%] rounded-full bg-emerald-400"></div>
            </div>
            <span class="text-xs font-semibold text-emerald-400">84</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
