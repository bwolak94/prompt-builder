---
import type { SystemTemplate } from '@/db/types';
import TemplateCard from './TemplateCard.astro';

// Fetch is_featured templates during SSR via the server Supabase client set by middleware
let templates: SystemTemplate[] = [];

try {
  const { data, error } = await Astro.locals.supabase
    .from('system_templates')
    .select('*')
    .eq('is_featured', true)
    .order('order_index')
    .limit(4);

  if (!error && data) {
    templates = data;
  }
} catch {
  // Supabase unavailable (e.g. during local dev without Docker) — render no cards
}
---

<section class="px-4 py-20 sm:py-28" aria-labelledby="featured-heading">
  <div class="mx-auto max-w-5xl">
    <!-- Heading -->
    <div class="mb-10 flex items-end justify-between">
      <div>
        <h2
          id="featured-heading"
          class="text-text-primary text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Wyróżnione szablony
        </h2>
        <p class="text-text-secondary mt-2">Sprawdzone przez AI, gotowe do użycia i forkowania.</p>
      </div>
      <a
        href="/explore"
        class="text-brand-400 hover:text-brand-300 hidden shrink-0 text-sm transition-colors sm:block"
      >
        Wszystkie szablony →
      </a>
    </div>

    {
      templates.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {templates.map((template) => (
            <TemplateCard template={template} />
          ))}
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {Array.from({ length: 4 }).map(() => (
            <div class="animate-shimmer border-border h-56 rounded-xl border" />
          ))}
        </div>
      )
    }

    <!-- Mobile "all templates" link -->
    <div class="mt-6 text-center sm:hidden">
      <a href="/explore" class="text-brand-400 hover:text-brand-300 text-sm transition-colors">
        Przeglądaj wszystkie szablony →
      </a>
    </div>
  </div>
</section>
