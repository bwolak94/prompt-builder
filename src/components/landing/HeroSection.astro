---
/**
 * TASK-014 — Hero Section
 * Pure Astro, zero JavaScript.
 * LCP element: <h1> text — no images.
 */
---

<section
  class="relative overflow-hidden px-4 pb-24 pt-20 sm:pb-32 sm:pt-28"
  aria-labelledby="hero-headline"
>
  <!-- CSS grid background -->
  <div
    class="bg-grid bg-grid-fade pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>

  <!-- Radial glow behind headline -->
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-brand-500/5 blur-3xl"
    aria-hidden="true"
  ></div>

  <!-- Floating builder-block decorations -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Role block — violet, top-left -->
    <div
      class="animate-float absolute left-[8%] top-[12%] hidden -rotate-6 rounded-xl border border-violet-600/25 bg-violet-600/10 px-4 py-3 backdrop-blur-sm lg:block"
      style="animation-delay: 0s;"
    >
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-violet-400"></span>
        <span class="text-xs font-medium text-violet-300">Rola</span>
      </div>
      <p class="mt-1 text-xs text-text-muted">Jesteś ekspertem od…</p>
    </div>

    <!-- Context block — blue, top-right -->
    <div
      class="animate-float absolute right-[9%] top-[18%] hidden rotate-3 rounded-xl border border-blue-600/25 bg-blue-600/10 px-4 py-3 backdrop-blur-sm lg:block"
      style="animation-delay: 0.8s;"
    >
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-blue-400"></span>
        <span class="text-xs font-medium text-blue-300">Kontekst</span>
      </div>
      <p class="mt-1 text-xs text-text-muted">Tworzę aplikację SaaS…</p>
    </div>

    <!-- Task block — emerald, bottom-right -->
    <div
      class="animate-float absolute bottom-[20%] right-[7%] hidden rotate-2 rounded-xl border border-emerald-600/25 bg-emerald-600/10 px-4 py-3 backdrop-blur-sm xl:block"
      style="animation-delay: 1.6s;"
    >
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        <span class="text-xs font-medium text-emerald-300">Zadanie</span>
      </div>
      <p class="mt-1 text-xs text-text-muted">Napisz szczegółowy plan…</p>
    </div>
  </div>

  <!-- Content -->
  <div class="relative mx-auto max-w-3xl text-center">
    <!-- Badge -->
    <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1">
      <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
      <span class="text-xs font-medium text-brand-300">AI Prompt Builder</span>
    </div>

    <!-- H1 — LCP element -->
    <h1
      id="hero-headline"
      class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
    >
      Buduj&nbsp;
      <span class="text-gradient">lepsze&nbsp;prompty</span>
      <br />szybciej&nbsp;niż&nbsp;kiedykolwiek
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-base text-text-secondary sm:text-lg">
      Wizualny kreator promptów z AI scoringiem, biblioteką szablonów i zmiennymi.
      Zbuduj, oceń i udostępnij — wszystko w jednym miejscu.
    </p>

    <!-- CTA buttons -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/register"
        class="shadow-glow inline-flex items-center gap-2 rounded-lg bg-brand-500 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-600 focus-visible:outline-2 focus-visible:outline-brand-500"
      >
        Zacznij za darmo
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a
        href="/explore"
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-2.5 text-sm font-semibold text-text-secondary transition-colors hover:border-border-strong hover:text-text-primary focus-visible:outline-2 focus-visible:outline-brand-500"
      >
        Przeglądaj szablony
      </a>
    </div>

    <!-- Social proof hint -->
    <p class="mt-8 text-xs text-text-muted">
      Bez karty kredytowej &nbsp;·&nbsp; 20+ gotowych szablonów
    </p>
  </div>
</section>
