# ============================================================
# PromptBase — Environment Variables
# Copy to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (self-hosted, Docker Compose) ───────────────────
# Public URL of the Supabase API gateway (Kong)
PUBLIC_SUPABASE_URL=http://localhost:8000

# Anon key — safe to expose in browser (RLS enforced)
# Default dev key derived from JWT_SECRET below
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqd6500zjNDhYgYDEvMGkuiN9bNkUqeMk

# Service role key — SERVER ONLY, never expose to client
# Default dev key derived from JWT_SECRET below
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── Docker Compose secrets ───────────────────────────────────
# PostgreSQL superuser password
POSTGRES_PASSWORD=your-super-secret-postgres-password

# JWT secret — must be at least 32 characters
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Anon and service role keys (same as above, used by Kong)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqd6500zjNDhYgYDEvMGkuiN9bNkUqeMk
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── Site URLs ────────────────────────────────────────────────
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# ── AI Providers ─────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Which provider to use for AI scoring: "openai" | "anthropic"
AI_SCORE_PROVIDER=openai

# ── SMTP (optional — dev uses Inbucket on localhost:54324) ───
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=fake@example.com
SMTP_PASS=fake_pass
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=PromptBase
